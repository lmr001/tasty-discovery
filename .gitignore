# .gitignore - Android / AndroidStudio / Kotlin combined

# Built application files
*.apk
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
/bin/
/gen/
/build/
**/build/
/captures/

# Gradle
.gradle/
/local.properties
/.gradle

# Signing files
*.jks
*.keystore

# Native build
.externalNativeBuild/
.cxx/

# Android Studio
.idea/
*.iml
.gradle

# Kotlin
*.kotlin_module
*.kotlin_metadata

# Log files
*.log

# OS
.DS_Store

# Others
*.hprof

# Keystore and signing
*.keystore
*.jks

# Exclude navigation Editor temp files
.navigation/

# Crashlytics
crashlytics.properties

# Kotlin/Native
.kotlin/local-build-cache/

# JetBrains
out/

# End of file
